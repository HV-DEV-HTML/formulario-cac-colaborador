---

import MaxIlimitado from './Planes/MaxIlimitado.astro';
import MaxTab from './Planes/Max.astro';

---

<style is:inline>
  body.pe .cChat {
    display: flex !important;
  }

  @media (max-width: 959px) {
    body.pe .cChat .ico-whatsapp-s:before {
      top: 8px;
      position: absolute;
    }
  }

  .c19pe {
    padding-bottom: 40px !important;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body.scrollhidden {
    overflow: hidden;
    position: relative;
  }

  body.scrollhidden::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 998;
    background-color: #888888;
    mix-blend-mode: multiply;
  }

  section[category] {
    height: 0;
    overflow: hidden;
    padding: 0 !important;
  }

  section[category].active {
    display: block;
    height: auto;
    padding: 50px 0 !important;
  }

  section.tabs {
    padding: 0;
    background: #fff;
    -webkit-box-shadow: 0 4px 4px 0 rgba(0, 0, 0, 0.15);
    box-shadow: 0 4px 4px 0 rgba(0, 0, 0, 0.15);
    position: relative;
    z-index: 2;
  }

  section.tabs .container {
    display: -webkit-box;
    display: -ms-flexbox;
    display: flex;
    -webkit-box-pack: center;
    -ms-flex-pack: center;
    justify-content: center;
    -webkit-box-align: center;
    -ms-flex-align: center;
    align-items: center;
  }

  section.tabs .container .tab {
    color: #979797;
    font-family: AMX;
    text-align: center;
    font-size: 22px;
    font-weight: 700;
    line-height: normal;
    padding: 17px 30px;
    position: relative;
    cursor: pointer;
  }

  section.tabs .container .tab.active {
    color: #da291c;
  }

  section.tabs .container .tab.active::before {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    background: #da291c;
    width: 100%;
    height: 4px;
  }

  section.bajada {
    padding: 85px 0;
    padding-bottom: 30px;
  }

  section.bajada h2 {
    color: #000;
    text-align: center;
    font-family: AMX;
    font-size: 36px;
    font-style: normal;
    font-weight: 700;
    line-height: normal;
  }

  section.bajada p {
    padding-top: 40px;
    color: #000;
    text-align: center;
    font-family: Roboto;
    font-size: 16px;
    font-weight: 400;
    line-height: normal;
    max-width: 1145px;
    margin: 0 auto;
  }

  section.tramites h2 {
    color: #000;
    text-align: center;
    font-family: AMX;
    font-size: 36px;
    font-style: normal;
    font-weight: 700;
    line-height: normal;
  }

  section.tramites .tabsTramites {
    display: -webkit-box;
    display: -ms-flexbox;
    display: flex;
    -webkit-box-pack: center;
    -ms-flex-pack: center;
    justify-content: center;
    margin-top: 35px;
  }

  section.tramites .tabsTramites .tab {
    color: #6c6c6c;
    font-family: "AMX Medium";
    font-size: 20px;
    font-weight: 500;
    line-height: normal;
    width: 256px;
    position: relative;
    text-align: center;
    padding-bottom: 16px;
    cursor: pointer;
  }

  section.tramites .tabsTramites .tab.active {
    color: #3c3c3c;
    font-weight: 700;
    font-family: AMX;
  }

  section.tramites .tabsTramites .tab.active::before {
    content: "";
    width: 100%;
    height: 4px;
    position: absolute;
    bottom: 0;
    left: 0;
    background: -webkit-gradient(
      linear,
      right top,
      left top,
      from(rgba(218, 41, 28, 0)),
      color-stop(52%, #da291c),
      to(rgba(218, 41, 28, 0))
    );
    background: linear-gradient(
      270deg,
      rgba(218, 41, 28, 0) 0%,
      #da291c 52%,
      rgba(218, 41, 28, 0) 100%
    );
  }

  section.tramites .containerSlider .sliderPresenciales .slick-dots {
    display: none;
  }

  section.tramites .containerSlider .sliderCards {
    height: 0;
    overflow: hidden;
    margin-top: 0;
    margin-bottom: 0;
    padding: 0 50px;
  }

  section.tramites .containerSlider .sliderCards.active {
    margin-top: 50px;
    height: auto;
  }

  section.tramites .containerSlider .slick-prev:before,
  section.tramites .containerSlider .slick-next:before {
    display: none;
  }

  section.tramites .containerSlider .slick-prev {
    left: 0;
    -webkit-transform: translate(0, -50%) rotate(180deg);
    transform: translate(0, -50%) rotate(180deg);
  }

  section.tramites .containerSlider .slick-next {
    right: 0;
  }

  section.tramites .containerSlider .slick-prev,
  section.tramites .containerSlider .slick-next {
    background-image: url(https://www.claro.com.pe/assets/havas/landing-formulario-cac-colaborador/assets/icon-flecha.svg);
    background-repeat: no-repeat;
    background-size: 100%;
    width: 40px;
    height: 40px;
  }

  section.tramites .containerSlider .slick-dots li button::before {
    display: none;
  }

  section.tramites .containerSlider .slick-dots {
    position: initial;
    padding-bottom: 6px;
    margin-top: 50px;
  }

  section.tramites .containerSlider .slick-dots li {
    width: 12px;
    height: 12px;
    -webkit-transition: 0.2s linear;
    transition: 0.2s linear;
  }

  section.tramites .containerSlider .slick-dots li.slick-active {
    width: 40px;
    height: 12px;
  }

  section.tramites .containerSlider .slick-dots li button {
    border-radius: 13px;
    background: #dbdbdb;
    -webkit-transition: 0.2s linear;
    transition: 0.2s linear;
    width: 100%;
    height: 100%;
  }

  section.tramites .containerSlider .slick-dots li.slick-active button {
    width: 100%;
    height: 100%;
    background: #d9291b;
    -webkit-box-shadow:
      0 1px 3px 0 rgba(0, 0, 0, 0.05),
      0 20px 40px 0 rgba(92, 103, 153, 0.2);
    box-shadow:
      0 1px 3px 0 rgba(0, 0, 0, 0.05),
      0 20px 40px 0 rgba(92, 103, 153, 0.2);
  }

  section.tramites .containerSlider .slick-slide {
    margin: 0 10px;
  }

  section.tramites .containerSlider .item {
    padding: 30px 15px 19px 15px;
    -webkit-transition: 0.3s linear;
    transition: 0.3s linear;
    border-radius: 20px;
    cursor: pointer;
    position: relative;
    pointer-events: none;
    cursor: default;
  }

  section.tramites .containerSlider .item a {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  section.tramites .containerSlider .item img {
    margin: 0 auto;
  }

  section.tramites .containerSlider .item h3 {
    color: #3c3c3c;
    text-align: center;
    font-family: AMX;
    font-size: 20px;
    font-weight: 700;
    line-height: normal;
    margin-bottom: 17px;
  }

  section.tramites .containerSlider .item p {
    color: #3c3c3c;
    text-align: center;
    font-family: Roboto;
    font-size: 16px;
    font-weight: 400;
    line-height: normal;
  }

  section.tramites .containerSlider .slick-track {
    display: flex;
  }

  section.tramites .containerSlider .item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-direction: column;
    gap: 17px;
    height: auto;
  }

  section.tramites .containerSlider .item button {
    color: #da291c;
    text-align: center;
    font-family: AMX;
    font-size: 16px;
    font-weight: 700;
    line-height: normal;
    width: 70%;
    padding: 8px 0;
    border-radius: 20px;
    border: 2px solid var(--Rojo-600, #da291c);
    text-decoration: none;
    background-color: transparent;
    display: block;
    margin: 0 auto;
    pointer-events: none;
    transition: 0.2s linear;
    background-color: #fff;
  }

  /*section.tramites .containerSlider .sliderPresenciales .item:first-child {
    border-radius: 20px;
    background: #da291c;
  }

  section.tramites .containerSlider .sliderPresenciales .item:first-child h3 {
    color: #fff;
  }

  section.tramites .containerSlider .sliderPresenciales .item:first-child p {
    color: #fff;
  }

  section.tramites
    .containerSlider
    .sliderPresenciales
    .item:first-child
    button {
    color: #ee122c;
    border: 2px solid var(--Rojo-600, #fff);
    background-color: #fff;
  }

  section.tramites .containerSlider .item:hover button,
  section.tramites
    .containerSlider
    .sliderPresenciales
    .item:first-child:hover
    button {
    color: #fff;
    background-color: #da291c;
  }*/

  section.contentFormulario {
    padding-top: 0;
    padding-bottom: 80px;
  }

  section.contentFormulario .container {
    max-width: 1440px;
  }

  section.contentFormulario .container #app {
    border-radius: 20.25px;
    /*overflow: hidden;*/
  }

  section.contentFormulario .container .portlet[data-portlet="bannerform"] {
    height: 634px;
    height: 550px;
  }

  section.contentFormulario
    .container
    .portlet[data-portlet="bannerform"]
    .section__align
    .content {
    margin-right: 27px;
  }

  section.contentFormulario
    .container
    .portlet[data-portlet="bannerform"]
    .section__align
    .content::before {
    background: #da291c;
  }

  section.tabla {
    padding-top: 0 !important;
    /*
  .contenTabla {
    margin-top: 27px;
    table {
      border-radius: 26px;
      background: #fff;
      padding: 12px 10px;
      max-width: 1185px;
      width: 100%;
      margin: 0 auto;
      tr.header {
        background: #ffc722;
      }
    }
  }
*/
  }

  section.tabla h2 {
    color: #000;
    text-align: center;
    font-family: AMX;
    font-size: 32px;
    font-weight: 700;
    line-height: normal;
  }

  section.tabla .tabla-contenedor {
    background: #fff;
    border-radius: 26px;
    -webkit-box-shadow: 0 0 15px 0 rgba(0, 0, 0, 0.25);
    box-shadow: 0 0 15px 0 rgba(0, 0, 0, 0.25);
    overflow: hidden;
    max-width: 900px;
    margin: 30px auto;
    padding: 12px 11px;
  }

  section.tabla table {
    width: 100%;
    border-collapse: collapse;
  }

  section.tabla thead {
    background: #ffc722;
    /* Amarillo */
    color: #000;
    text-align: left;
  }

  section.tabla thead tr {
    border-radius: 20px;
  }

  section.tabla thead th {
    padding: 12px 15px;
    font-weight: bold;
    font-size: 14px;
    text-align: center;
  }

  section.tabla tbody td {
    padding: 12px 15px;
    border-bottom: 1px solid #dbdbdb;
    font-size: 14px;
    text-align: center;
    color: #000;
    font-family: Roboto;
    font-size: 14px;
    font-weight: 400;
    line-height: normal;
  }

  section.tabla tbody td.tachado {
    text-decoration: line-through;
  }

  section.tabla tbody tr:last-child td {
    border-bottom: none;
  }

  section.tabla[category].active {
    padding-top: 0 !important;
  }

  section.campanasPromociones h2 {
    color: #000;
    text-align: center;
    font-family: AMX;
    font-size: 32px;
    font-weight: 700;
    line-height: normal;
  }

  section.campanasPromociones .containerslider {
    max-width: 1429px;
    margin: 0 auto;
    margin-top: 30px;
    padding: 0 50px;
  }

  section.campanasPromociones .containerslider .slick-slide {
    margin: 0 15px;
  }

  section.campanasPromociones .containerslider .slick-prev:before,
  section.campanasPromociones .containerslider .slick-next:before {
    display: none;
  }

  section.campanasPromociones .containerslider .slick-prev {
    left: -36px;
    -webkit-transform: translate(0, -50%) rotate(180deg);
    transform: translate(0, -50%) rotate(180deg);
  }

  section.campanasPromociones .containerslider .slick-next {
    right: -36px;
  }

  section.campanasPromociones .containerslider .slick-prev,
  section.campanasPromociones .containerslider .slick-next {
    background-image: url(https://www.claro.com.pe/assets/havas/landing-formulario-cac-colaborador/assets/icon-flecha.svg);
    background-repeat: no-repeat;
    background-size: 100%;
    width: 40px;
    height: 40px;
    background-color: #fff;
    border-radius: 50%;
    z-index: 2;
  }

  section.campanasPromociones .containerslider .slick-dots li button::before {
    display: none;
  }

  section.campanasPromociones .containerslider .slick-dots {
    position: absolute;
    bottom: -50px;
  }

  section.campanasPromociones .containerslider .slick-dots li {
    width: 12px;
    height: 12px;
    -webkit-transition: 0.2s linear;
    transition: 0.2s linear;
  }

  section.campanasPromociones .containerslider .slick-dots li.slick-active {
    width: 40px;
    height: 12px;
  }

  section.campanasPromociones .containerslider .slick-dots li button {
    border-radius: 13px;
    background: #dbdbdb;
    -webkit-transition: 0.2s linear;
    transition: 0.2s linear;
    width: 100%;
    height: 100%;
  }

  section.campanasPromociones
    .containerslider
    .slick-dots
    li.slick-active
    button {
    width: 100%;
    height: 100%;
    background: #d9291b;
    -webkit-box-shadow:
      0 1px 3px 0 rgba(0, 0, 0, 0.05),
      0 20px 40px 0 rgba(92, 103, 153, 0.2);
    box-shadow:
      0 1px 3px 0 rgba(0, 0, 0, 0.05),
      0 20px 40px 0 rgba(92, 103, 153, 0.2);
  }

  section.campanasPromociones .containerslider .item {
    border-radius: 24px;
    overflow: hidden;
    position: relative;
  }

  section.campanasPromociones .containerslider .item .fondo {
    position: relative;
    z-index: 1;
  }

  section.campanasPromociones .containerslider .item .fondo::before {
    content: "";
    position: absolute;
    top: 0;
    background: rgba(0, 0, 0, 0.65);
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
  }

  section.campanasPromociones .containerslider .item .fondo img {
    width: 100%;
    transition: 0.2s linear;
  }

  section.campanasPromociones .containerslider .item:hover .fondo img {
    transform: scale(1.1);
  }

  section.campanasPromociones .containerslider .item .info {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    z-index: 2;
    padding: 30px 20px;
  }

  section.campanasPromociones .containerslider .item .info span {
    color: #fff;
    text-align: center;
    display: block;
    font-family: AMX;
    font-size: 16px;
    font-weight: 700;
    line-height: normal;
  }

  section.campanasPromociones .containerslider .item .info h3 {
    color: #fff;
    text-align: center;
    font-family: AMX;
    font-size: 24px;
    font-weight: 700;
    line-height: normal;
  }

  section.campanasPromociones .containerslider .item .info P {
    color: #fff;
    text-align: center;
    font-family: AMX;
    font-size: 32px;
    font-weight: 700;
    line-height: normal;
    margin-top: 2px;
  }

  section.campanasPromociones .containerslider .item button {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    border: none;
    background: transparent;
    cursor: pointer;
  }

  section.campanasPromociones .containerslider .item .info .conocemas {
    color: #fff;
    cursor: pointer;
    text-align: center;
    font-family: AMX;
    font-size: 16px;
    font-weight: 700;
    border: none;
    line-height: normal;
    width: 80%;
    border-radius: 20px;
    display: block;
    margin: 0 auto;
    padding: 12px 0;
    margin-top: 28px;
    background: linear-gradient(272deg, #b52217 0%, #da291c 100%);
    -webkit-box-shadow:
      0 -4px 10px 0 rgba(45, 45, 45, 0.6) inset,
      4px 4px 14px 0 rgba(255, 255, 255, 0.4) inset,
      0 6px 24px 0 rgba(131, 23, 15, 0.4);
    box-shadow:
      0 -4px 10px 0 rgba(45, 45, 45, 0.6) inset,
      4px 4px 14px 0 rgba(255, 255, 255, 0.4) inset,
      0 6px 24px 0 rgba(131, 23, 15, 0.4);
  }

  .modal {
    position: fixed;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    z-index: 999;
    height: 100dvh;
    display: none;
  }

  .modal.active {
    display: block;
  }

  .modal .container {
    height: 100%;
    display: -webkit-box;
    display: -ms-flexbox;
    display: flex;
    -webkit-box-pack: center;
    -ms-flex-pack: center;
    justify-content: center;
    -webkit-box-align: center;
    -ms-flex-align: center;
    align-items: center;
  }

  .modal .container .content {
    max-width: 760px;
    width: 100%;
    position: relative;
    min-height: 350px;
    border-radius: 32px;
    background: #fff;
    -webkit-box-shadow: 0 2px 9px 0 rgba(140, 140, 140, 0.5);
    box-shadow: 0 2px 9px 0 rgba(140, 140, 140, 0.5);
    padding: 50px 45px 30px 45px;
    display: -webkit-box;
    display: -ms-flexbox;
    display: flex;
    -webkit-box-orient: vertical;
    -webkit-box-direction: normal;
    -ms-flex-direction: column;
    flex-direction: column;
    -webkit-box-pack: justify;
    -ms-flex-pack: justify;
    justify-content: space-between;
  }

  .modal .container .content .close {
    position: absolute;
    top: 35px;
    right: 35px;
    cursor: pointer;
    z-index: 3;
  }

  .modal .container .content h3 {
    color: #283342;
    font-family: AMX;
    font-size: 24px;
    font-weight: 700;
    line-height: normal;
    margin-bottom: 15px;
  }

  .modal .container .content .info ul {
    margin-left: 19px;
  }

  .modal .container .content .info ul li {
    color: #283342;
    font-family: Roboto;
    font-size: 16px;
    font-weight: 400;
    line-height: normal;
    list-style: disc;
  }

  .modal .container .content .info table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
    margin-bottom: 20px;
  }

  .modal .container .content .info table th {
    padding: 10px 0;
    color: #fff;
    text-align: center;
    font-family: Roboto;
    font-size: 14px;
    font-style: normal;
    font-weight: 700;
    line-height: normal;
  }

  .modal .container .content .info table td {
    padding: 10px 20px;
    color: #000;
    text-align: center;
    font-family: Roboto;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
  }

  .modal .container .content button {
    color: #fff;
    text-align: center;
    font-family: Roboto;
    font-size: 15px;
    font-weight: 700;
    line-height: normal;
    border-radius: 25px;
    background: #da291c;
    width: 140px;
    padding: 10px 0;
    border: none;
    margin: 0 auto;
    cursor: pointer;
  }

