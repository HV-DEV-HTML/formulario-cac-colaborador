<script is:inline>
  $(document).ready(function () {
    $("section.tramites .sliderPresenciales").slick({
      arrows: true,
      dots: true,
      slidesToShow: 4,
      slidesToScroll: 1,
      infinite: false,
      responsive: [
        {
          breakpoint: 1217,
          settings: {
            slidesToShow: 3,
            slidesToScroll: 3,
          },
        },
        {
          breakpoint: 851,
          settings: {
            slidesToShow: 2,
            slidesToScroll: 2,
            arrows: true,
          },
        },
        {
          breakpoint: 501,
          settings: {
            slidesToShow: 1,
            slidesToScroll: 1,
            arrows: true,
          },
        },
      ],
    });
    $("section.tramites .sliderNoPresenciales").slick({
      arrows: true,
      slidesToShow: 4,
      slidesToScroll: 1,
      infinite: false,
      dots: true,
      responsive: [
        {
          breakpoint: 1217,
          settings: {
            slidesToShow: 3,
            slidesToScroll: 3,
          },
        },
        {
          breakpoint: 851,
          settings: {
            slidesToShow: 2,
            slidesToScroll: 2,
            arrows: true,
          },
        },
        {
          breakpoint: 501,
          settings: {
            slidesToShow: 1,
            slidesToScroll: 1,
            arrows: true,
          },
        },
      ],
    });

    const tabs = document.querySelectorAll(
      "section.tramites .tabsTramites .tab",
    );
    const sliderPresenciales = document.querySelector(
      "section.tramites .sliderPresenciales",
    );
    const sliderNoPresenciales = document.querySelector(
      "section.tramites .sliderNoPresenciales",
    );

    // función para actualizar según tab activo
    function actualizarSliders(tabActivo) {
      const categoria = tabActivo.getAttribute("category");

      // quitar active de todos
      tabs.forEach((t) => t.classList.remove("active"));
      sliderPresenciales.classList.remove("active");
      sliderNoPresenciales.classList.remove("active");

      // activar el tab clicado
      tabActivo.classList.add("active");

      // activar el slider según la categoría
      if (categoria === "Presenciales") {
        sliderPresenciales.classList.add("active");
      } else if (categoria === "No presenciales") {
        sliderNoPresenciales.classList.add("active");
      }
    }

    // inicializar con el tab que ya tiene "active"
    const tabInicial = document.querySelector(
      "section.tramites .tabsTramites .tab.active",
    );
    if (tabInicial) {
      actualizarSliders(tabInicial);
    }

    // evento click en cada tab
    tabs.forEach((tab) => {
      tab.addEventListener("click", function () {
        actualizarSliders(this);
      });
    });

    const tabs2 = document.querySelectorAll(".tabsInfo .tab");
    const sections = document.querySelectorAll("section[category]");

    tabs2.forEach((tab) => {
      tab.addEventListener("click", function () {
        const category = this.getAttribute("category");

        // quitar active de todos los tabs del grupo .tabsInfo
        tabs2.forEach((t) => t.classList.remove("active"));
        this.classList.add("active");

        // ocultar todas las secciones
        sections.forEach((sec) => {
          sec.classList.remove("active");
          if (sec.getAttribute("category") === category) {
            sec.classList.add("active");
          }
        });
      });
    });

    $(".sliderCampanas").slick({
      arrows: true,
      slidesToShow: 4,
      slidesToScroll: 1,
      infinite: false,
      dots: true,
      responsive: [
        {
          breakpoint: 1217,
          settings: {
            slidesToShow: 3,
            slidesToScroll: 3,
          },
        },
        {
          breakpoint: 851,
          settings: {
            slidesToShow: 2,
            slidesToScroll: 2,
            arrows: true,
          },
        },
        {
          breakpoint: 501,
          settings: {
            slidesToShow: 1,
            slidesToScroll: 1,
            arrows: true,
          },
        },
      ],
    });

    /* modales promociones */

    document.querySelector("#cableIphone").addEventListener("click", () => {
      document.querySelector(".modal.cableIphone").classList.add("active");
      document.querySelector("body").classList.add("scrollhidden");
    });
    document.querySelector("#cargador").addEventListener("click", () => {
      document.querySelector(".modal.cargador").classList.add("active");
      document.querySelector("body").classList.add("scrollhidden");
    });
    /*document.querySelector('#iphoneXRXS').addEventListener('click', () => {
      document.querySelector('.modal.iphoneXRXS').classList.add('active');
      document.querySelector('body').classList.add('scrollhidden');
    });*/
    document.querySelector("#polos").addEventListener("click", () => {
      document.querySelector(".modal.polos").classList.add("active");
      document.querySelector("body").classList.add("scrollhidden");
    });

    document.querySelectorAll(".modal .close").forEach((btn) => {
      btn.addEventListener("click", function () {
        const modales = document.querySelectorAll(".modal");
        modales.forEach((element) => {
          element.classList.remove("active");
        });
        document.querySelector("body").classList.remove("scrollhidden");
      });
    });

    document.querySelectorAll(".modal button").forEach((btn) => {
      btn.addEventListener("click", function () {
        const modales = document.querySelectorAll(".modal");
        modales.forEach((element) => {
          element.classList.remove("active");
        });
        document.querySelector("body").classList.remove("scrollhidden");
      });
    });

    /* end modales promociones */

    $(".sliderPlanesMovil").slick({
      arrows: true,
      slidesToShow: 3,
      slidesToScroll: 3,
      infinite: false,
      dots: true,
      responsive: [
        {
          breakpoint: 1217,
          settings: {
            slidesToShow: 3,
            slidesToScroll: 3,
          },
        },
        {
          breakpoint: 851,
          settings: {
            slidesToShow: 2,
            slidesToScroll: 2,
            arrows: true,
          },
        },
        {
          breakpoint: 501,
          settings: {
            slidesToShow: 1,
            slidesToScroll: 1,
            arrows: true,
          },
        },
      ],
    });

    $(".sliderPlanesHogaruno").slick({
      arrows: true,
      slidesToShow: 4,
      slidesToScroll: 1,
      infinite: false,
      dots: true,
      responsive: [
        {
          breakpoint: 1217,
          settings: {
            slidesToShow: 3,
            slidesToScroll: 3,
          },
        },
        {
          breakpoint: 851,
          settings: {
            slidesToShow: 2,
            slidesToScroll: 2,
            arrows: true,
          },
        },
        {
          breakpoint: 501,
          settings: {
            slidesToShow: 1,
            slidesToScroll: 1,
            arrows: true,
          },
        },
      ],
    });

    document
      .querySelectorAll(".sliderPlanesHogaruno .item .tab")
      .forEach((tab) => {
        tab.addEventListener("click", function () {
          const parentItem = this.closest(".item");
          parentItem.classList.toggle("active");
        });
      });
    document
      .querySelectorAll(".sliderPlanesMovil .item .tab")
      .forEach((tab) => {
        tab.addEventListener("click", function () {
          const parentItem = this.closest(".item");
          parentItem.classList.toggle("active");
        });
      });

    $(".sliderPlanesHogardos").slick({
      arrows: true,
      slidesToShow: 4,
      slidesToScroll: 1,
      infinite: false,
      dots: true,
      responsive: [
        {
          breakpoint: 1217,
          settings: {
            slidesToShow: 3,
            slidesToScroll: 3,
          },
        },
        {
          breakpoint: 851,
          settings: {
            slidesToShow: 2,
            slidesToScroll: 2,
            arrows: true,
          },
        },
        {
          breakpoint: 501,
          settings: {
            slidesToShow: 1,
            slidesToScroll: 1,
            arrows: true,
          },
        },
      ],
    });

    document
      .querySelectorAll(".sliderPlanesHogardos .item .tab")
      .forEach((tab) => {
        tab.addEventListener("click", function () {
          const parentItem = this.closest(".item");
          parentItem.classList.toggle("active");
        });
      });

    const buttonPaquetesTV = document.querySelectorAll(
      "section.planesHogar .sliderPlanesHogar .item button.btnaction",
    );
    if (buttonPaquetesTV) {
      buttonPaquetesTV.forEach((element) => {
        element.addEventListener("click", function () {
          const label = document.querySelector(
            '.portlet[data-portlet="bannerform"] .section__align .content .formBC__main .radio label[for="venta"]',
          );
          if (label) {
            label.click();
            const target = document.querySelector("section.contentFormulario");
            if (target) {
              const offset = 100; // píxeles más arriba
              const elementPosition =
                target.getBoundingClientRect().top + window.pageYOffset;
              const offsetPosition = elementPosition - offset;

              window.scrollTo({
                top: offsetPosition,
                behavior: "smooth",
              });
            }
          }
        });
      });
    }

    const buttonPaquetesmovil = document.querySelectorAll(
      "section.planesMovil .sliderPlanesMovil .item button.btnaction",
    );
    if (buttonPaquetesmovil) {
      buttonPaquetesmovil.forEach((element) => {
        element.addEventListener("click", function () {
          const label = document.querySelector(
            '.portlet[data-portlet="bannerform"] .section__align .content .formBC__main .radio label[for="venta"]',
          );
          if (label) {
            label.click();
            const target = document.querySelector("section.contentFormulario");
            if (target) {
              const offset = 100; // píxeles más arriba
              const elementPosition =
                target.getBoundingClientRect().top + window.pageYOffset;
              const offsetPosition = elementPosition - offset;

              window.scrollTo({
                top: offsetPosition,
                behavior: "smooth",
              });
            }
          }
        });
      });
    }
  });
</script>

